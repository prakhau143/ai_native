# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Groq (free AI summary) ───────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
# If absent, app falls back to template summaries — fully functional without this
GROQ_API_KEY=your-groq-key-here

# ── Gmail SMTP (transactional email) ─────────────────────────────────────────
# 1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
# 2. Then: Security → App Passwords → create one called "SpendWiseAI"
# 3. Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password

# ── Slack Alerts (optional) ──────────────────────────────────────────────────
# Create an Incoming Webhook at https://api.slack.com/apps
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Cron secret (Vercel cron auth) ───────────────────────────────────────────
CRON_SECRET=change-me-to-a-long-random-string

# ── App URL (used in emails + OG images) ─────────────────────────────────────
# Local: http://localhost:3000 | Prod: https://yourdomain.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
